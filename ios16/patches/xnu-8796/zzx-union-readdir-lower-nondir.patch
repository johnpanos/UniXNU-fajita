--- a/bsd/vfs/vfs_lookup.c
+++ b/bsd/vfs/vfs_lookup.c
@@ -1512,7 +1512,19 @@
 	nd.ni_dvp = dvp->v_mount->mnt_vnodecovered;
 	error = namei(&nd);
 	if (error == 0) {
-		*new_dvp = nd.ni_vp;
+		if (nd.ni_vp->v_type != VDIR) {
+			/*
+			 * The lower layer has a non-directory at this path (the OS volume has a non-directory where the SystemOS
+			 * cryptex has directories, e.g. /System/Library/Frameworks/WebKit.framework). It contributes no entries:
+			 * report "no lower directory" (ENOENT, the ordinary end of a union directory) instead of handing a
+			 * non-directory to getdirentries/getattrlistbulk, which fail EINVAL/ENOTDIR and broke readdir of the union
+			 * directory (CFBundle then never registered com.apple.WebKit).
+			 */
+			vnode_put(nd.ni_vp);
+			error = ENOENT;
+		} else {
+			*new_dvp = nd.ni_vp;
+		}
 	}
 	nameidone(&nd);
 done:
