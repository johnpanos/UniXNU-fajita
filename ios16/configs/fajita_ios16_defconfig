# Kernel configuration of the fajita iOS 16 image (iPhone10,6, 20H392), the iPad fajita_defconfig with the 20H392 volumes.
# The sheng set without the board's GPU, display, boot progress and Data ramdisk parts. The UFS root uses the
# NativeUfs copy in drivers/NativeUfs, the NativeVirtioBlock storage bindings and verified root archive built by
# scripts/build-fajita-storage.py and build-fajita-verified-root.py, and the sheng PMGR stub the original AMFI needs.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
# Off: the iOS 16 ADT sets vmm-present, so the 20H392 AMFI does not wait for a PMGR (the stub is bound to 21H461).
CONFIG_XNU_SHENG_PMGR=n
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# The touch bring-up and the CPU clock probe (both default off), as on the iPad board; NativeDwc3 is not linked (its personality patch is iPad-only).
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/fajita-dwc3/libNativeDwc3.a -Wl,-force_load,{tree}/build/fajita-cpufreq/libFajitaCpuFreq.a"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/native-virtio-block-verified-bundle/libNativeVirtioBlock.a"
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
# Off until the display driver is ported to the 20H392 IOMobileGraphicsFamily (fajita_ios16_display_defconfig has it on).
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="01EBF4D7-BD9F-4FCA-A9B0-4608872D60B1"
CONFIG_XNU_BOOT_PROGRESS=y
# The OS and SystemOS volumes of 20H392 (read from the images' APFS volume superblocks), for the owner SystemOS mount
# and boot manifest of the xnu-8796 series.
CONFIG_XNU_OWNER_OS_VOLUME_UUID="DADD93F8-DBBF-4B17-A1DF-0F11E64172F7"
CONFIG_XNU_OWNER_SYSTEMOS_VOLUME_UUID="96096B28-B6DC-4BC7-9D3A-2632A0FE53F1"
