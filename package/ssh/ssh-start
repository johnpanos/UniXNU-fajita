#!/private/var/ngpu/ssh/bin/bash
# ssh-start: the phone side of the fajita SSH dev mode (NOTES-devmode.md). Run (and rerun when it exits) by the USB debug agent's
# SSH supervisor when the kernel has fajita-ssh=1 (package/usb-debug-tools/fjdbg-agent.c), with stdout/stderr appended to
# /private/var/ssh/ssh.log. Prepares the state directory, generates the host keys on first start, installs the authorized keys the
# add-on carries, then execs dropbear in the foreground on port 22 (FAJITA_SSH_PORT in etc/ssh.conf overrides it).
#
#   /private/var/ngpu/ssh   the add-on (rewritten from the boot payload every boot): bin/, libexec/, etc/, share/terminfo
#   /private/var/ssh        state on persistent Data, root 0700: host keys, authorized_keys, dropbear.log
set -u
R=/private/var/ngpu/ssh
S=/private/var/ssh
PATH=$R/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077
# toybox applets as links next to it (toybox with no arguments lists them); the add-on cannot carry links, so until they exist
# every tool is called through toybox.
cd "$R/bin" || exit 1
for c in $(./toybox); do
  [ -e "$c" ] || [ -L "$c" ] || ./toybox ln -s toybox "$c"
done
cd /
mkdir -p "$S" && chmod 700 "$S"
echo "ssh-start: $(date) pid $$"

# Host keys: made here on first start, kept on Data across boots and reflashes of the payload.
for t in ed25519 ecdsa rsa; do
  k=$S/dropbear_${t}_host_key
  if [ ! -s "$k" ]; then
    rm -f "$k"
    "$R/bin/dropbearkey" -t "$t" -f "$k" || echo "ssh-start: cannot make the $t host key"
  fi
done

# authorized_keys = the keys baked into the add-on at build time (etc/authorized_keys, from the builder's ~/.ssh/*.pub) plus any
# added on the phone (authorized_keys.local, kept across boots). dropbear reads it from $S (-D), as root.
for f in "$R/etc/authorized_keys" "$S/authorized_keys.local"; do
  if [ -f "$f" ]; then cat "$f"; fi
done > "$S/authorized_keys.new"
chmod 600 "$S/authorized_keys.new" && mv -f "$S/authorized_keys.new" "$S/authorized_keys"
echo "ssh-start: $(grep -c '^[a-z]' "$S/authorized_keys" 2>/dev/null || echo 0) authorized keys"

# root's home (dropbear starts the login shell there)
mkdir -p /private/var/root && chmod 755 /private/var/root

# Keep the log bounded: one generation of 1 MiB.
for f in "$S/ssh.log" "$S/dropbear.log"; do
  [ -f "$f" ] && [ "$(stat -c %s "$f" 2>/dev/null || echo 0)" -gt 1048576 ] && mv -f "$f" "$f.1"
done

PORT=22
[ -f "$R/etc/ssh.conf" ] && . "$R/etc/ssh.conf"
PORT=${FAJITA_SSH_PORT:-$PORT}
keys=()
for t in ed25519 ecdsa rsa; do [ -s "$S/dropbear_${t}_host_key" ] && keys+=(-r "$S/dropbear_${t}_host_key"); done
echo "ssh-start: dropbear on port $PORT"
# -F foreground (the supervisor restarts it), -E log to stderr (dropbear.log: every connection, auth success and failure),
# -s -g no password logins (also compiled out), -G wheel root only, -D the authorized_keys directory, -T 3 auth tries per connection, -K 30 keepalive.
exec "$R/bin/dropbear" -F -E -s -g -G wheel -T 3 -K 30 -p "$PORT" -D "$S" -P "$S/dropbear.pid" "${keys[@]}" 2>> "$S/dropbear.log"
